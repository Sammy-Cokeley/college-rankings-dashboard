# Copy to .env and adjust if you changed docker-compose.yml's credentials.
#
# DATABASE_URL is the pipeline/web app's live database connection.
# TEST_DATABASE_URL is used by pipeline Go tests and web Vitest tests — each
# test gets its own throwaway Postgres schema on this connection (created and
# dropped per test), so it's safe to point at the same local instance.
#
# Port 5433, not Postgres's default 5432 — docker-compose.yml maps it there to
# avoid colliding with any other local Postgres install on the dev machine.
DATABASE_URL=postgres://rankings:rankings@localhost:5433/rankings?sslmode=disable
TEST_DATABASE_URL=postgres://rankings:rankings@localhost:5433/rankings?sslmode=disable

# nuxt-auth-utils session cookie encryption key — 32+ characters, required in
# production. Generate your own with: openssl rand -hex 32
# (nuxt-auth-utils auto-generates a dev-only one if this is unset, but every
# dev then gets a different key, invalidating each other's session cookies —
# setting one here keeps a shared/team dev setup consistent.)
NUXT_SESSION_PASSWORD=replace-with-openssl-rand--hex-32-output-32-chars-min
