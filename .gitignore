# Go build output
*.exe
*.test
*.out
/pipeline/pipeline

# Node deps (web/ has its own .gitignore too, but this covers any stray
# root-level node_modules, e.g. from running npm here by mistake)
node_modules/

# SQLite databases (built locally; never committed)
*.db
*.db-wal
*.db-shm
*.db-journal

# Local env (DB connection strings)
.env

# Local Claude Code config (machine-specific) + tool artifacts
.claude/settings.local.json
.playwright-mcp/

# Editor / OS cruft
.DS_Store
Thumbs.db
